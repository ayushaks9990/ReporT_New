# Core application
ENVIRONMENT=development
DATABASE_URL=sqlite:///./ai-analytic-platform.db
JWT_SECRET=replace-with-a-long-random-value
SESSION_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Microsoft AutoGen + GROQ. Leave the key blank to use the verified local engine.
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# Semantic retrieval. Render uses PostgreSQL + pgvector; SQLite is for local development.
# Example PostgreSQL URL: postgresql+psycopg://user:password@localhost:5432/report
# MiniLM weights download once locally and are prefetched by the Docker build.
EMBEDDING_CACHE_DIR=.cache/fastembed
EMBEDDING_LOCAL_FILES_ONLY=false
EMBEDDING_THREADS=1
EMBEDDING_BATCH_SIZE=16
RAG_TOP_K=6

# Optional report delivery
GMAIL_USER=
GMAIL_APP_PASSWORD=
TELEGRAM_BOT_TOKEN=
